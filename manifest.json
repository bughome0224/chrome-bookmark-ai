{
  "manifest_version": 3,
  "name": "智能收藏夹",
  "version": "1.0.0",
  "description": "AI 驱动的智能书签分类助手——收藏网页时自动推荐最合适的文件夹",
  "permissions": [
    "bookmarks",
    "storage",
    "activeTab",
    "notifications"
  ],
  "host_permissions": [
    "https://api.anthropic.com/*",
    "https://api.openai.com/*",
    "https://api.deepseek.com/*"
  ],
  "web_accessible_resources": [
    {
      "resources": ["config.json"],
      "matches": ["<all_urls>"]
    }
  ],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["dialog/dialog.js", "content/content.js"],
      "css": ["dialog/dialog.css"],
      "run_at": "document_end"
    }
  ],
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "智能收藏夹"
  },
  "options_page": "options/options.html",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
